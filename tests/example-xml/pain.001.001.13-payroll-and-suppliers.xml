        <!-- ============================================================ -->
        <PmtInf>
            <PmtInfId>PLACEHOLDER-PMT-INF-SUPPLIERS-2026-05</PmtInfId>
            <PmtMtd>TRF</PmtMtd>
            <BtchBookg>true</BtchBookg>
