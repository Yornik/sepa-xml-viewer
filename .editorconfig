root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[Makefile]
indent_style = tab

[*.{cpp,cc,cxx,h,hpp,hh,hxx}]
indent_size = 4

[CMakeLists.txt]
indent_size = 2

[*.cmake]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
